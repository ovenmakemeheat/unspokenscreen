{
  "name": "unspokenscreen",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "@types/node": "^22.0.0",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "postgres": "^3.4.5",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @unspokenscreen/db db:push",
    "db:studio": "turbo -F @unspokenscreen/db db:studio",
    "db:generate": "turbo -F @unspokenscreen/db db:generate",
    "db:migrate": "turbo -F @unspokenscreen/db db:migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@unspokenscreen/env": "workspace:*",
    "dotenv": "catalog:",
    "hono": "^4.12.14",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@unspokenscreen/config": "workspace:*",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5"
}
